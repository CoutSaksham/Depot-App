<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Depot" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Depot">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    
    <header style="display:flex; align-items:center; gap:20px; padding:8px 32px; background:#15803d; color:#ffffff; box-shadow:0 2px 8px rgba(0,0,0,0.12);">

      <%= image_tag "logo.svg",
          alt: "The Pragmatic Bookshelf",
          style: "width:65px; height:65px; object-fit:contain;" %>

      <div>
        <h1 style="margin:0; font-size:22px; font-weight:750; letter-spacing:-0.4px;">
          <%= @page_title %>
        </h1>
        <p style="margin:3px 0 0; font-size:12px; color:#dcfce7;">
          The Pragmatic Bookshelf
        </p>
      </div>
    </header>

    <section style="display:flex; min-height:calc(100vh - 91px); background:#f8fafc;">

      <nav style="width:220px; flex-shrink:0; padding:28px 16px; box-sizing:border-box; background:#14532d;">

        <p style="margin:0 0 16px 12px; font-size:11px; font-weight:700; color:#86efac; text-transform:uppercase; letter-spacing:0.1em;">
          Navigation
        </p>

        <%= render partial: 'layouts/cart', locals: {cart: @cart } %>

        <ul style="margin:0; padding:0; list-style:none;">

          <li style="margin-bottom:6px;">
            <a href="/"
              style="display:block; padding:11px 13px; color:#ffffff; text-decoration:none; font-size:14px; font-weight:600; border-radius:8px; background:#166534;">
              Home
            </a>
          </li>

          <li style="margin-bottom:6px;">
            <a href="/questions"
              style="display:block; padding:11px 13px; color:#d1fae5; text-decoration:none; font-size:14px; border-radius:8px;">
              Questions
            </a>
          </li>

          <li style="margin-bottom:6px;">
            <a href="/news"
              style="display:block; padding:11px 13px; color:#d1fae5; text-decoration:none; font-size:14px; border-radius:8px;">
              News
            </a>
          </li>

          <li style="margin-bottom:6px;">
            <a href="/contact"
              style="display:block; padding:11px 13px; color:#d1fae5; text-decoration:none; font-size:14px; border-radius:8px;">
              Contact
            </a>
          </li>

        </ul>

      </nav>

      <main style="flex:1; min-width:0; padding:32px; box-sizing:border-box;">

        <div style="width:100%; max-width:1100px; margin:0 auto;">
          <%= yield %>

        </div>

      </main>

    </section>

  </body>
</html>
