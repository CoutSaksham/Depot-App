<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Depot" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Depot">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    
    <header style="display:flex; align-items:center; gap:20px; padding:8px 32px; background:#15803d; color:#ffffff; box-shadow:0 2px 8px rgba(0,0,0,0.12);">

      <%= image_tag "logo.svg",
          alt: "The Pragmatic Bookshelf",
          style: "width:65px; height:65px; object-fit:contain; flex-shrink:0;" %>

      <div style="display:flex; flex-direction:column; justify-content:center;">
        <h1 style="margin:0; font-size:22px; font-weight:750; letter-spacing:-0.4px; color:#ffffff;">
          <%= @page_title %>
        </h1>
        <p style="margin:3px 0 0; font-size:12px; color:#dcfce7;">
          The Pragmatic Bookshelf
        </p>
      </div>

      <aside data-controller="locale" style="margin-left:auto;">
        <%= form_tag request.path, method: :get, class: 'locale',
            style: "display:flex; align-items:center; gap:6px; margin:0;" do %>

          <%= select_tag 'set_locale',
            options_for_select(LANGUAGES, I18n.locale.to_s),
            onchange: 'this.form.submit()',
            style: "padding:7px 10px; background:#ffffff; color:#14532d; border:1px solid #bbf7d0; border-radius:7px; font-size:13px; font-weight:500; cursor:pointer;" %>

        <% end %>
      </aside>

    </header>

    <section style="display:flex; min-height:calc(100vh - 91px); background:#f8fafc;">

      <nav style="width:220px; flex-shrink:0; padding:28px 16px; box-sizing:border-box; background:#14532d;">

        <p style="margin:0 0 16px 12px; font-size:11px; font-weight:700; color:#86efac; text-transform:uppercase; letter-spacing:0.1em;">
          Navigation
        </p>

        <%= render partial: 'layouts/cart', locals: {cart: @cart } %>

        

    <ul style="list-style:none; padding:0; margin:0; color:#d1d5db; line-height:2.2;">
      <li>
        <a href="/" style="display:block; padding:5px 12px; color:#f0fdf4; text-decoration:none; font-size:14px; border-radius:6px;"
          onmouseover="this.style.background='rgba(255,255,255,0.12)'"
          onmouseout="this.style.background='transparent'">
          <%= t('.home') %>
        </a>
      </li>
      <li>
        <a href="/questions" style="display:block; padding:5px 12px; color:#f0fdf4; text-decoration:none; font-size:14px; border-radius:6px;"
          onmouseover="this.style.background='rgba(255,255,255,0.12)'"
          onmouseout="this.style.background='transparent'">
          <%= t('.questions') %>
        </a>
      </li>
      <li>
        <a href="/news" style="display:block; padding:5px 12px; color:#f0fdf4; text-decoration:none; font-size:14px; border-radius:6px;"
          onmouseover="this.style.background='rgba(255,255,255,0.12)'"
          onmouseout="this.style.background='transparent'">
          <%= t('.news') %>
        </a>
      </li>
      <li>
        <a href="/rails/conductor/action_mailbox/inbound_emails/new" style="display:block; padding:5px 12px; color:#f0fdf4; text-decoration:none; font-size:14px; border-radius:6px;"
          onmouseover="this.style.background='rgba(255,255,255,0.12)'"
          onmouseout="this.style.background='transparent'">
          <%= t('.contact') %>
        </a>
      </li>
    </ul>



        <% if session[:user_id] %>

          <div style="margin:14px 0; border-top:1px solid rgba(255,255,255,0.2);"></div>

          <p style="margin:0 0 10px; color:#bbf7d0; font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase;">
            Admin Menu
          </p>

          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:6px;">

            <li>
              <%= link_to "Orders", orders_path,
                  style: "display:block; padding:10px 13px; color:#f0fdf4; text-decoration:none; font-size:14px; font-weight:500; border-radius:7px; background:rgba(255,255,255,0.06);",
                  onmouseover: "this.style.background='rgba(255,255,255,0.15)'",
                  onmouseout: "this.style.background='rgba(255,255,255,0.06)'" %>
            </li>

            <li>
              <%= link_to "Products", products_path,
                  style: "display:block; padding:10px 13px; color:#f0fdf4; text-decoration:none; font-size:14px; font-weight:500; border-radius:7px; background:rgba(255,255,255,0.06);",
                  onmouseover: "this.style.background='rgba(255,255,255,0.15)'",
                  onmouseout: "this.style.background='rgba(255,255,255,0.06)'" %>
            </li>

            <li>
              <%= link_to "Users", users_path,
                  style: "display:block; padding:10px 13px; color:#f0fdf4; text-decoration:none; font-size:14px; font-weight:500; border-radius:7px; background:rgba(255,255,255,0.06);",
                  onmouseover: "this.style.background='rgba(255,255,255,0.15)'",
                  onmouseout: "this.style.background='rgba(255,255,255,0.06)'" %>
            </li>

            <li>
              <%= link_to "Support Requests", support_requests_path,
                  style: "display:block; padding:10px 13px; color:#f0fdf4; text-decoration:none; font-size:14px; font-weight:500; border-radius:7px; background:rgba(255,255,255,0.06);",
                  onmouseover: "this.style.background='rgba(255,255,255,0.15)'",
                  onmouseout: "this.style.background='rgba(255,255,255,0.06)'" %>
            </li>

            <li style="margin-top:10px;">
              <%= button_to "Logout", logout_path,
                  method: :delete,
                  form: { style: "margin:0;" },
                  style: "width:100%; padding:10px 13px; background:#dc2626; color:#ffffff; border:0; border-radius:7px; font-size:14px; font-weight:600; text-align:left; cursor:pointer;" %>
            </li>

          </ul>

        <% end %>

      </nav>

      <main style="flex:1; min-width:0; padding:32px; box-sizing:border-box;">

        <div style="width:100%; max-width:1100px; margin:0 auto;">
          <%= yield %>

        </div>

      </main>

    </section>

  </body>
</html>
