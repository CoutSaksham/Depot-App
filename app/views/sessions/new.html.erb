
<div style="width:100%; max-width:450px; margin:50px auto; padding:0 12px; box-sizing:border-box;">

  <!-- Login Card -->
  <div style="background:#ffffff; padding:30px; border:1px solid #e2e8f0; border-radius:14px; box-shadow:0 5px 18px rgba(0,0,0,0.07);">

    <% if notice.present? %>
      <p id="notice" style="padding:12px 14px; background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; border-radius:8px; margin:0 0 20px; font-size:13px; font-weight:600;">
        <%= notice %>
      </p>
    <% end %>

    <%= form_tag do %>

      <!-- Heading -->
      <div style="text-align:center; margin-bottom:28px;">
        <h2 style="margin:0; color:#14532d; font-size:28px; font-weight:800;">
          Please Log In
        </h2>

        <p style="margin:7px 0 0; color:#64748b; font-size:13px;">
          Enter your credentials to access your account.
        </p>
      </div>

      <!-- Name -->
      <div style="margin:20px 0;">
        <%= label_tag :name, "Name:",
            style: "display:block; margin-bottom:7px; color:#334155; font-size:14px; font-weight:600;" %>

        <%= text_field_tag :name, params[:name],
            style: "width:100%; padding:12px 13px; border:1px solid #cbd5e1; border-radius:8px; font-size:14px; color:#1e293b; box-sizing:border-box; outline:none;",
            placeholder: "Enter your username",
            autocomplete: "username" %>
      </div>

      <!-- Password -->
      <div style="margin:20px 0;">
        <%= label_tag :password, "Password:",
            style: "display:block; margin-bottom:7px; color:#334155; font-size:14px; font-weight:600;" %>

        <%= password_field_tag :password, nil,
            style: "width:100%; padding:12px 13px; border:1px solid #cbd5e1; border-radius:8px; font-size:14px; color:#1e293b; box-sizing:border-box; outline:none;",
            placeholder: "Enter your password",
            autocomplete: "current-password" %>
      </div>

      <!-- Login Button -->
      <div style="margin-top:28px;">
        <%= submit_tag "Login",
            style: "width:100%; padding:13px 20px; background:#15803d; color:#ffffff; border:0; border-radius:8px; font-size:15px; font-weight:700; cursor:pointer; box-shadow:0 2px 5px rgba(0,0,0,0.12);" %>
      </div>

    <% end %>

  </div>

</div>
