
<div id="<%= dom_id order %>" style="width:100%; box-sizing:border-box; margin:20px 0; padding:22px; background:#ffffff; border:1px solid #e5e7eb; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">

  <h3 style="margin:0 0 18px; padding-bottom:12px; border-bottom:1px solid #e5e7eb; color:#14532d; font-size:18px; font-weight:700;">
    Order Details
  </h3>

  <div style="display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:20px 30px;">

    <div>
      <strong style="display:block; margin-bottom:5px; color:#64748b; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">Name</strong>
      <span style="color:#1e293b; font-size:14px; font-weight:500;"><%= order.name %></span>
    </div>

    <div>
      <strong style="display:block; margin-bottom:5px; color:#64748b; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">Address</strong>
      <span style="color:#1e293b; font-size:14px;"><%= order.address %></span>
    </div>

    <div>
      <strong style="display:block; margin-bottom:5px; color:#64748b; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">Email</strong>
      <span style="color:#2563eb; font-size:14px;"><%= order.email %></span>
    </div>

    <div>
      <strong style="display:block; margin-bottom:5px; color:#64748b; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">Pay Type</strong>
      <span style="display:inline-block; padding:5px 10px; background:#dcfce7; color:#166534; border-radius:6px; font-size:13px; font-weight:600;">
        <%= order.pay_type %>
      </span>
    </div>

    <div style="grid-column:1 / -1;">
      <strong style="display:block; margin-bottom:10px; color:#64748b; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">Line Items</strong>
      <%= render order.line_items %>
    </div>

    <div style="grid-column:1 / -1; padding-top:14px; border-top:1px solid #e5e7eb;">
      <strong style="display:block; margin-bottom:7px; color:#64748b; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">Total Amount</strong>
      <span style="display:inline-block; padding:7px 12px; background:#dcfce7; color:#166534; border-radius:6px; font-size:15px; font-weight:700;">
        <%= number_to_currency(order.total_price) %>
      </span>
    </div>

  </div>
</div>
