
<% content_for :title, "Orders" %>

<div style="width:100%; max-width:1100px; margin:20px auto; padding:0 12px; box-sizing:border-box;">

  <% if notice.present? %>
    <p id="notice" style="padding:12px 16px; background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; border-radius:8px; margin-bottom:20px; font-size:14px; font-weight:600;">
      <%= notice %>
    </p>
  <% end %>

  <!-- Page Header -->
  <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:24px; padding-bottom:16px; border-bottom:1px solid #e2e8f0;">

    <div>
      <h1 style="margin:0; color:#14532d; font-size:28px; font-weight:800;">
        Orders
      </h1>
      <p style="margin:5px 0 0; color:#64748b; font-size:14px;">
        View and manage all your orders.
      </p>
    </div>

    <%= link_to "＋ New Order", new_order_path,
        style: "display:inline-block; padding:11px 18px; background:#15803d; color:#ffffff; text-decoration:none; border-radius:8px; font-size:14px; font-weight:600; box-shadow:0 2px 5px rgba(0,0,0,0.10);" %>

  </div>

  <!-- Orders List -->
  <div id="orders" style="display:flex; flex-direction:column; gap:16px; width:100%;">

    <% if @orders.any? %>

      <% @orders.each do |order| %>

        <div style="display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; padding:18px; background:#ffffff; border:1px solid #e2e8f0; border-radius:11px; box-shadow:0 2px 7px rgba(0,0,0,0.04);">

          <!-- Order Information -->
          <div style="flex:1; min-width:220px;">
            <%= render order %>
          </div>

          <!-- Action Buttons -->
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">

            <%= link_to "Show", order,
                style: "display:inline-block; padding:9px 16px; background:#dcfce7; color:#166534; text-decoration:none; border-radius:7px; font-size:13px; font-weight:600; text-align:center;" %>

            <%= link_to "Edit", edit_order_path(order),
                style: "display:inline-block; padding:9px 16px; background:#eff6ff; color:#1d4ed8; text-decoration:none; border-radius:7px; font-size:13px; font-weight:600; text-align:center;" %>

            <%= button_to "Delete", order,
                method: :delete,
                form: { style: "display:inline-block; margin:0;" },
                style: "padding:9px 16px; background:#dc2626; color:#ffffff; border:0; border-radius:7px; font-size:13px; font-weight:600; cursor:pointer;",
                data: { turbo_confirm: "Are you sure you want to delete this order?" } %>

          </div>

        </div>

      <% end %>

    <% else %>

      <div style="padding:40px 20px; text-align:center; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:10px;">
        <p style="margin:0 0 6px; color:#475569; font-size:16px; font-weight:600;">
          No orders found
        </p>
        <p style="margin:0; color:#94a3b8; font-size:13px;">
          Create a new order to get started.
        </p>
      </div>

    <% end %>

  </div>

</div>
