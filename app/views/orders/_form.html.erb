
<%= form_with(model: order, style: "width:100%;") do |form| %>

  <% if order.errors.any? %>
    <div id="error_explanation" style="background:#fef2f2; color:#b91c1c; padding:14px 16px; border:1px solid #fecaca; border-radius:8px; margin:16px 0;">
      <h2><%=raw t('errors.template.header', count: @order.errors.count, model: t('activerecord.models.order')) %>.</h2>
      <p><%= t('errors.template.body') %></p>

      <ul style="margin:0; padding-left:20px; font-size:13px;">
        <% order.errors.each do |error| %>
          <li><%=raw error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Name -->
  <div style="margin:20px 0;">
    <%= form.label :name, t('.name'), style: "display:block; margin-bottom:7px; color:#334155; font-size:14px; font-weight:600;" %>

    <%= form.text_field :name,
        style: "width:100%; padding:11px 13px; border:1px solid #{order.errors[:name].any? ? '#f87171' : '#cbd5e1'}; border-radius:8px; font-size:14px; color:#1e293b; box-sizing:border-box; outline:none;",
        placeholder: "Enter your full name" %>
  </div>

  <!-- Address -->
  <div style="margin:20px 0;">
    <%=  form.label :address, t('.address_html'), style: "display:block; margin-bottom:7px; color:#334155; font-size:14px; font-weight:600;" %>

    <%= form.text_area :address, rows: 4,
        style: "width:100%; padding:11px 13px; border:1px solid #{order.errors[:address].any? ? '#f87171' : '#cbd5e1'}; border-radius:8px; font-size:14px; color:#1e293b; box-sizing:border-box; resize:vertical;",
        placeholder: "Enter your complete delivery address" %>
  </div>

  <!-- Email -->
  <div style="margin:20px 0;">
    <%=  form.label :email, t('.email'), style: "display:block; margin-bottom:7px; color:#334155; font-size:14px; font-weight:600;" %>

    <%= form.email_field :email,
        style: "width:100%; padding:11px 13px; border:1px solid #{order.errors[:email].any? ? '#f87171' : '#cbd5e1'}; border-radius:8px; font-size:14px; color:#1e293b; box-sizing:border-box;",
        placeholder: "Enter your email address" %>
  </div>

  <div data-controller="payment">
    <div class="my-5">
      <%= form.label :pay_type %>
      <%= form.select :pay_type,
      Order.pay_types.keys.map {|key| [t(".pay_types.#{key}"), key] },
      { prompt:  t('.pay_prompt_html') },
      'data-payment-target' => 'selection',
      'data-action' => 'payment#showAdditionalFields',
      class: "input-field" %>
    </div>
    <%= render partial: 'check', locals: {form: form} %>
    <%= render partial: 'cc', locals: {form: form} %>
    <%= render partial: 'po', locals: {form: form} %>
  </div>

  <!-- Submit Button -->
  <div style="margin-top:26px;">
    <%= form.submit "Realizar Pedido",
        style: "width:100%; padding:13px 20px; background:#15803d; color:#ffffff; border:0; border-radius:8px; font-size:15px; font-weight:700; cursor:pointer; box-shadow:0 2px 5px rgba(0,0,0,0.12);" %>
  </div>

<% end %>
