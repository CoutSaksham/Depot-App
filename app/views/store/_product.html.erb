
<%= turbo_frame_tag(dom_id(product)) do %>
  <li style="display:flex; align-items:flex-start; gap:20px; padding:20px; margin-bottom:18px; background:#ffffff; border:1px solid #e2e8f0; border-radius:12px; box-shadow:0 2px 8px rgba(15,23,42,0.04); list-style:none;">

    <!-- Product Image -->
    <div style="width:125px; height:155px; flex-shrink:0; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
      <%= image_tag(product.image_url,
          style: "width:100%; height:100%; object-fit:contain; padding:8px; box-sizing:border-box;") %>
    </div>

    <!-- Product Details -->
    <div style="flex:1; min-width:0; display:flex; flex-direction:column;">

      <h2 style="margin:0 0 10px; color:#14532d; font-size:19px; font-weight:700; line-height:1.4;">
        <%= product.title %>
      </h2>

      <div style="color:#64748b; font-size:14px; line-height:1.7;">
        <%= sanitize(product.description) %>
      </div>

      <!-- Price and Add to Cart -->
      <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:18px; padding-top:14px; border-top:1px solid #e2e8f0;">

        <span style="color:#15803d; font-size:20px; font-weight:800;">
          <%= number_to_currency(product.price) %>
        </span>

        <%= button_to 'Add to Cart',
            line_items_path(product_id: product),
            form: { style: "display:inline-block; margin:0;" },
            style: "padding:9px 16px; color:#ffffff; background:#15803d; border:none; border-radius:7px; font-size:13px; font-weight:600; cursor:pointer; box-shadow:0 2px 4px rgba(21,128,61,0.15);" %>

      </div>
    </div>
  </li>
<% end %>
