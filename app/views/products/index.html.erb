<% content_for :title, "Products" %>

<div style="width:100%; max-width:1100px; margin:0 auto; padding:24px 16px; box-sizing:border-box; color:#334155;">

  <% if notice.present? %>
    <div id="notice"
         style="max-width:450px; margin:0 auto 24px; padding:12px 16px; box-sizing:border-box; background:#f0fdf4; border:1px solid #bbf7d0; border-left:4px solid #16a34a; border-radius:9px; color:#166534; font-size:14px;">
      <%= notice %>
    </div>
  <% end %>

  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:28px;">
    <div>
      <h1 style="margin:0; font-size:30px; font-weight:750; color:#0f172a;">
        Products
      </h1>
      <p style="margin:6px 0 0; font-size:14px; color:#64748b;">
        Browse and manage your products
      </p>
    </div>

    <%= link_to "＋ New product", new_product_path,
        style: "display:inline-block; padding:11px 17px; background:#2563eb; color:#ffffff; text-decoration:none; border-radius:9px; font-size:14px; font-weight:600; box-shadow:0 2px 5px rgba(37,99,235,0.2);" %>
  </div>

  <% if @products.any? %>
    <div id="products"
         style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr)); gap:20px;">

      <% @products.each do |product| %>
        <div style="display:flex; flex-direction:column; min-width:0; padding:20px; box-sizing:border-box; background:#ffffff; border:1px solid #e2e8f0; border-radius:13px; box-shadow:0 3px 10px rgba(15,23,42,0.04);">

          <div style="flex:1; min-width:0;">
            <% if product.image_url.present? %>
              <div style="display:flex; align-items:center; justify-content:center; height:170px; margin-bottom:18px; padding:10px; box-sizing:border-box; background:#f8fafc; border-radius:9px;">
                <%= image_tag product.image_url,
                  alt: product.title,
                  style: "display:block; width:100%; max-width:250px; max-height:220px; object-fit:contain;" %>
              </div>
            <% end %>

            <h2 style="margin:0 0 8px; font-size:19px; font-weight:700; color:#0f172a; overflow-wrap:anywhere;">
              <%= product.title %>
            </h2>

            <p style="margin:0 0 16px; font-size:13px; line-height:1.6; color:#64748b; overflow-wrap:anywhere;">
              <%= truncate(product.description.to_s, length:110) %>
            </p>

            <div style="margin-bottom:20px; font-size:22px; font-weight:700; color:#2563eb;">
              <%= product.enabled ? number_to_currency(product.discount_price) : number_to_currency(product.price) %>
            </div>
          </div>

          <div style="display:flex; flex-wrap:wrap; gap:8px; padding-top:15px; border-top:1px solid #e2e8f0;">

            <%= link_to "Show", product,
                style: "flex:1; min-width:55px; padding:9px 10px; box-sizing:border-box; text-align:center; background:#eff6ff; color:#1d4ed8; text-decoration:none; border-radius:7px; font-size:13px; font-weight:600;" %>

            <%= link_to "Edit", edit_product_path(product),
                style: "flex:1; min-width:55px; padding:9px 10px; box-sizing:border-box; text-align:center; background:#f1f5f9; color:#334155; text-decoration:none; border-radius:7px; font-size:13px; font-weight:600;" %>

            <%= button_to "Delete", product, method: :delete,
                form: { style: "flex:1; min-width:65px; margin:0;" },
                style: "width:100%; padding:9px 10px; box-sizing:border-box; border:none; background:#fef2f2; color:#b91c1c; border-radius:7px; font-size:13px; font-weight:600; cursor:pointer;",
                data: { turbo_confirm: "Are you sure you want to delete this product?" } %>

          </div>
        </div>
      <% end %>

    </div>
  <% else %>
    <div style="padding:50px 20px; text-align:center; background:#ffffff; border:1px dashed #cbd5e1; border-radius:13px;">
      <h2 style="margin:0 0 8px; font-size:18px; font-weight:650; color:#334155;">
        No products yet
      </h2>
      <p style="margin:0 0 20px; font-size:14px; color:#64748b;">
        Create your first product to get started.
      </p>
      <%= link_to "Create a product", new_product_path,
          style: "display:inline-block; padding:10px 16px; background:#2563eb; color:#ffffff; text-decoration:none; border-radius:8px; font-size:14px; font-weight:600;" %>
    </div>
  <% end %>

</div>
