
<% content_for :title, "Showing product" %>

<div style="width:100%; max-width:700px; margin:0 auto; padding:24px 16px; box-sizing:border-box; color:#334155;">

  <% if notice.present? %>
    <div id="notice"
         style="max-width:450px; margin:0 auto 24px; padding:12px 16px; box-sizing:border-box; background:#f0fdf4; border:1px solid #bbf7d0; border-left:4px solid #16a34a; border-radius:9px; color:#166534; font-size:14px;">
      <%= notice %>
    </div>
  <% end %>

  <div style="margin-bottom:24px;">
    <p style="margin:0 0 6px; font-size:12px; font-weight:600; color:#2563eb; text-transform:uppercase; letter-spacing:0.08em;">
      Product Details
    </p>

    <h1 style="margin:0; font-size:30px; font-weight:750; color:#0f172a;">
      Showing product
    </h1>

    <p style="margin:8px 0 0; font-size:14px; color:#64748b;">
      View the details and manage this product.
    </p>
  </div>

  <div style="padding:24px; background:#ffffff; border:1px solid #e2e8f0; border-radius:14px; box-shadow:0 4px 14px rgba(15,23,42,0.06);">
    <%= render @product %>
  </div>

  <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:22px;">

    <%= link_to "Edit product", edit_product_path(@product),
        style: "flex:1; min-width:130px; padding:11px 16px; box-sizing:border-box; text-align:center; background:#2563eb; color:#ffffff; text-decoration:none; border-radius:8px; font-size:14px; font-weight:600;" %>

    <%= link_to "Back to products", products_path,
        style: "flex:1; min-width:130px; padding:11px 16px; box-sizing:border-box; text-align:center; background:#f1f5f9; color:#334155; text-decoration:none; border:1px solid #e2e8f0; border-radius:8px; font-size:14px; font-weight:600;" %>

    <%= button_to "Delete product", @product, method: :delete,
        form: { style: "flex:1; min-width:130px; margin:0;" },
        style: "width:100%; padding:11px 16px; box-sizing:border-box; border:1px solid #fecaca; background:#fef2f2; color:#b91c1c; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;",
        data: { turbo_confirm: "Are you sure you want to delete this product?" } %>

  </div>

</div>
