<div id="<%= dom_id product %>"
     style="width:100%; max-width:500px; margin:20px auto; padding:24px; box-sizing:border-box; background:#ffffff; border:1px solid #e2e8f0; border-radius:14px; box-shadow:0 4px 12px rgba(15,23,42,0.06); color:#334155;">

  <div style="margin-bottom:20px;">
    <strong style="display:block; font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:6px;">Title</strong>
    <div style="font-size:20px; font-weight:700; color:#0f172a;">
      <%= product.title %>
    </div>
  </div>

  <div style="margin-bottom:20px;">
    <strong style="display:block; font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:6px;">Description</strong>
    <div style="font-size:14px; line-height:1.6; color:#475569; overflow-wrap:anywhere;">
      <%= product.description %>
    </div>
  </div>


  <% if product.image_url.present? %>
    <div style="margin-bottom:20px;">
      <strong>Product Image</strong>

      <%= image_tag product.image_url,
            alt: product.title,
            style: "display:block; width:100%; max-width:250px; max-height:220px; object-fit:contain;" %>
    </div>
  <% end %>


  <div style="padding-top:16px; border-top:1px solid #e2e8f0;">
    <strong style="display:block; font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:6px;">Price</strong>
    <div style="font-size:24px; font-weight:700; color:#2563eb;">
      <%= product.enabled ? number_to_currency(product.discount_price) : number_to_currency(product.price) %>
    </div>
  </div>

</div>
