<div id="<%= dom_id cart %>" style="width:100%; margin:0;">

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid #e2e8f0;">

    <h2 style="margin:0 0 12px; padding:10px 14px; background:#dcfce7; color:#14532d; font-size:18px; font-weight:700; letter-spacing:-0.3px; border-radius:8px;">
      <%= t('.title') %>
    </h2>

    <span style="padding:4px 9px; background:#dcfce7; color:#166534; border-radius:20px; font-size:11px; font-weight:700;">
      <%= cart.line_items.sum(&:quantity) %> items
    </span>
  </div>

  <% if cart.line_items.any? %>
    <div style="display:flex; flex-direction:column; gap:12px;">
      <%= render cart.line_items %>
    </div>

    <!-- Total Price -->
    <div style="margin-top:18px; padding:14px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:9px;">
      <p style="margin:0 0 5px; color:#166534; font-size:12px; font-weight:600;">
        Cart Total
      </p>

      <p style="margin:0; color:#15803d; font-size:23px; font-weight:800;">
        <%= number_to_currency(cart.total_price) %>
      </p>
    </div>

  <% else %>
    <div style="padding:24px 12px; text-align:center; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:9px;">
      <p style="margin:0 0 6px; color:#475569; font-size:14px; font-weight:600;">
        Your cart is empty
      </p>
      <p style="margin:0; color:#94a3b8; font-size:12px;">
        Add some books to get started.
      </p>
    </div>
  <% end %>

  

    <div style="display:flex; flex-direction:row; align-items:center;
            gap:12px; margin-top:16px; position:relative; z-index:10;">

      <%=  button_to t('.empty'), empty_cart_path(cart.id),
          method: :patch,
          form: { style: "display:inline-block; margin:0;" },
          style: "padding:10px 16px; background:#dc2626; color:#ffffff; border:0; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer;",
          data: { turbo_confirm: "Are you sure you want to empty this cart?" } %>

      <p>DEBUG LOCALE: <%= I18n.locale %></p>
      <p>DEBUG CHECKOUT: <%= t('.checkout') %></p>
      <p>DEBUG CART ITEMS: <%= cart.line_items.count %></p>
      <%=  button_to t('.checkout'), new_order_path(locale: I18n.locale),
          method: :get,
          form: { style: "display:inline-block; margin:0;" },
          style: "padding:10px 18px; background:#15803d; color:#ffffff; border:0; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer;" %>

    </div>
</div>
