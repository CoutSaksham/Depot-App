
<% content_for :title, "Showing cart" %>

<div style="max-width:900px; width:100%; margin:0 auto; padding:24px; box-sizing:border-box;">

  <% if notice.present? %>
    <p id="notice" style="padding:12px 16px; margin:0 0 20px; background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; border-radius:8px; font-size:14px; font-weight:500;">
      <%= notice %>
    </p>
  <% end %>

  <div style="margin-bottom:24px;">
    <h1 style="margin:0; font-size:30px; font-weight:750; letter-spacing:-0.6px; color:#14532d;">
      Showing Cart
    </h1>
    <p style="margin:6px 0 0; color:#64748b; font-size:14px;">
      Review your cart details below.
    </p>
  </div>

  <div style="background:#ffffff; border:1px solid #e2e8f0; border-radius:12px; padding:24px; box-shadow:0 4px 12px rgba(15,23,42,0.05); margin-bottom:24px;">
    <%= render @cart %>
  </div>

  <div style="display:flex; flex-wrap:wrap; align-items:center; gap:10px;">

    <% if false %>
      <%= link_to "Edit Cart", edit_cart_path(@cart),
          style: "display:inline-block; text-align:center; padding:11px 18px; background:#15803d; color:#ffffff; border-radius:8px; font-size:14px; font-weight:600; text-decoration:none; box-shadow:0 2px 4px rgba(21,128,61,0.18);" %>

      <%= link_to "Back to Carts", carts_path,
          style: "display:inline-block; text-align:center; padding:11px 18px; background:#ffffff; color:#334155; border:1px solid #cbd5e1; border-radius:8px; font-size:14px; font-weight:600; text-decoration:none;" %>

      <%= button_to "Destroy Cart", @cart,
          method: :delete,
          form: { style: "display:inline-block; margin:0;" },
          style: "display:inline-block; padding:11px 18px; background:#dc2626; color:#ffffff; border:0; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;",
          data: { turbo_confirm: "Are you sure you want to delete this cart?" } %>
    <% end %>

    <%= link_to "Shop more", store_index_path,
          style: "display:inline-block; text-align:center; padding:11px 18px; background:#ffffff; color:#334155; border:1px solid #cbd5e1; border-radius:8px; font-size:14px; font-weight:600; text-decoration:none;" %>

  </div>
</div>
