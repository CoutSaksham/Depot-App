<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      body {
        margin: 0;
        padding: 40px 16px;
        background-color: #f4f6f9;
        font-family: Arial, Helvetica, sans-serif;
        color: #333333;
      }

      .email-wrapper {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      }

      .header {
        background: #4f46e5;
        padding: 32px 24px;
        text-align: center;
        color: #ffffff;
      }

      .header h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
      }

      .content {
        padding: 36px 32px;
        text-align: center;
        line-height: 1.7;
      }

      .content p {
        margin: 0;
        font-size: 16px;
        color: #555555;
      }

      .greeting {
        color: #4f46e5;
        font-weight: 700;
      }

      .footer {
        padding: 20px;
        background: #f9fafb;
        text-align: center;
        font-size: 12px;
        color: #999999;
      }

      @media (max-width: 480px) {
        .content {
          padding: 28px 20px;
        }

        .header h1 {
          font-size: 22px;
        }
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="header">
        <h1>Welcome!</h1>
      </div>

      <div class="content">
        <p>
          <span class="greeting"><%= @greeting %></span>
        </p>
        <p style="margin-top: 16px;">
          We're glad you're here. Wishing you a wonderful day!
        </p>
      </div>

      <div class="footer">
        © <%= Date.current.year %> All rights reserved.
      </div>
    </div>
  </body>
</html>
