
<% content_for :title, "Showing user" %>

<div style="width:100%; max-width:850px; margin:30px auto; padding:0 12px; box-sizing:border-box;">

  <% if notice.present? %>
    <p id="notice" style="padding:12px 16px; background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; border-radius:8px; margin-bottom:20px; font-size:14px; font-weight:600;">
      <%= notice %>
    </p>
  <% end %>

  <!-- Page Heading -->
  <div style="margin-bottom:22px;">
    <h1 style="margin:0; color:#14532d; font-size:28px; font-weight:800;">
      User Details
    </h1>

    <p style="margin:6px 0 0; color:#64748b; font-size:14px;">
      View and manage user information.
    </p>
  </div>

  <!-- User Details Card -->
  <div style="background:#ffffff; padding:24px; border:1px solid #e2e8f0; border-radius:12px; box-shadow:0 3px 10px rgba(0,0,0,0.05); margin-bottom:22px;">
    <%= render @user %>
  </div>

  <!-- Action Buttons -->
  <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">

    <%= link_to "Edit User", edit_user_path(@user),
        style: "display:inline-block; padding:11px 18px; background:#15803d; color:#ffffff; text-decoration:none; border-radius:8px; font-size:14px; font-weight:600; text-align:center;" %>

    <%= link_to "Back to Users", users_path,
        style: "display:inline-block; padding:11px 18px; background:#f1f5f9; color:#334155; text-decoration:none; border:1px solid #e2e8f0; border-radius:8px; font-size:14px; font-weight:600; text-align:center;" %>

    <%= button_to "Delete User", @user,
        method: :delete,
        form: { style: "display:inline-block; margin:0;" },
        style: "padding:11px 18px; background:#dc2626; color:#ffffff; border:0; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;",
        data: { turbo_confirm: "Are you sure you want to delete this user?" } %>

  </div>

</div>
