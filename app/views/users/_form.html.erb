
<%= form_with(model: user, style: "width:100%;") do |form| %>

  <% if user.errors.any? %>
    <div id="error_explanation" style="background:#fef2f2; color:#b91c1c; padding:14px 16px; border:1px solid #fecaca; border-radius:8px; margin:16px 0;">
      <h2 style="margin:0 0 8px; font-size:14px; font-weight:700;">
        <%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:
      </h2>

      <ul style="margin:0; padding-left:20px; font-size:13px;">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <h2 style="margin:0 0 22px; color:#14532d; font-size:22px; font-weight:700;">
    Enter User Details
  </h2>

  <!-- Name -->
  <div style="margin:20px 0;">
    <%= form.label :name, "Name:",
        style: "display:block; margin-bottom:7px; color:#334155; font-size:14px; font-weight:600;" %>

    <%= form.text_field :name,
        style: "width:100%; padding:11px 13px; border:1px solid #{user.errors[:name].any? ? '#f87171' : '#cbd5e1'}; border-radius:8px; font-size:14px; color:#1e293b; box-sizing:border-box; outline:none;",
        placeholder: "Enter your full name" %>
  </div>

  <!-- Password -->
  <div style="margin:20px 0;">
    <%= form.label :password, "Password:",
        style: "display:block; margin-bottom:7px; color:#334155; font-size:14px; font-weight:600;" %>

    <%= form.password_field :password,
        style: "width:100%; padding:11px 13px; border:1px solid #{user.errors[:password].any? ? '#f87171' : '#cbd5e1'}; border-radius:8px; font-size:14px; color:#1e293b; box-sizing:border-box; outline:none;",
        placeholder: "Enter your password" %>
  </div>

  <!-- Confirm Password -->
  <div style="margin:20px 0;">
    <%= form.label :password_confirmation, "Confirm Password:",
        style: "display:block; margin-bottom:7px; color:#334155; font-size:14px; font-weight:600;" %>

    <%= form.password_field :password_confirmation,
        id: :user_password_confirmation,
        style: "width:100%; padding:11px 13px; border:1px solid #{user.errors[:password_confirmation].any? ? '#f87171' : '#cbd5e1'}; border-radius:8px; font-size:14px; color:#1e293b; box-sizing:border-box; outline:none;",
        placeholder: "Re-enter your password" %>
  </div>

  <!-- Submit Button -->
  <div style="margin-top:26px;">
    <%= form.submit "Save User",
        style: "width:100%; padding:13px 20px; background:#15803d; color:#ffffff; border:0; border-radius:8px; font-size:15px; font-weight:700; cursor:pointer; box-shadow:0 2px 5px rgba(0,0,0,0.12);" %>
  </div>

<% end %>
